#!/bin/sh
# pre-commit — Nexus Protocol DAO Bots (local, zero AI credits)
#
# Read-only validation before every commit: the bots CHECK but never write,
# so a commit can't ship half-updated reports. Report generation happens in
# scripts/bots-daily.sh (or npm run bots:all), which commits them explicitly.
#
# Quiet on success. Bypass once with:  git commit --no-verify -m "..."

ROOT=$(git rev-parse --show-toplevel)

run_check() {
  # $1 = bot script, $2 = display name
  if ! node "$ROOT/bots/$1" --check >/dev/null 2>&1; then
    echo ""
    echo "✗ $2 found problems:"
    node "$ROOT/bots/$1" --check 2>&1 | grep -E '✗|error|Error' | head -5
    echo ""
    echo "  Fix the above, or bypass once with:  git commit --no-verify"
    exit 1
  fi
}

run_check health-bot.js         "Health Bot"
run_check dao-accounting-bot.js "File-Accounting Bot"

exit 0
