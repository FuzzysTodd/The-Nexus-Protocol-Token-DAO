# Nexus Protocol — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Runtime ────────────────────────────────────────────────────────────────────
NEXUS_ENV=local          # local | remote

# ── Ports ─────────────────────────────────────────────────────────────────────
PORT=3000                # Main dashboard server
APPROVAL_SERVICE_PORT=8787
FINANCIAL_OPS_REST_PORT=8788
WITHDRAWS_PORT=8789
NEXUS_SIGNAL_BUS_PORT=8790

# ── Hosting (remote only) ──────────────────────────────────────────────────────
# NEXUS_HOST_URL=https://your-domain.com
# NEXUS_VERCEL_URL=https://nexus-protocol-dao.vercel.app

# ── Ethereum RPC ───────────────────────────────────────────────────────────────
# NEXUS_RPC_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY
# NEXUS_WS_RPC_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY
# RPC_URL_PRIMARY=https://mainnet.infura.io/v3/YOUR_KEY
# RPC_URL_FALLBACK=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Contract Addresses ────────────────────────────────────────────────────────
# NEXUS_BUILDER_FUND_ADDRESS=0x...
# NEXUS_GOVERNOR_ADDRESS=0x...
# NEXUS_TREASURY_ADDRESS=0x...
# NEXUS_TOKEN_ADDRESS=0x...

# ── Thinking models for the Intel Bot ───────────────────────────────────────────
# Explicit switch — NEXUS_THINK=off | local | remote
#   local  : your GPUs via Ollama — free of API credits; if the server is down
#            it reports UNAVAILABLE and NEVER falls back to a paid provider
#   remote : paid cloud API — needs BOTH this switch AND the key below
#            (a stray key alone never enables paid calls)
#   off    : deterministic, $0
# Unset   : local if a server answers, otherwise off — never paid
#
# Three modes, resolved in this order:
#
# 1. LOCAL GPU (recommended — free of API credits): run Ollama on the GPU
#    machine (https://ollama.com). The intel-bot auto-detects it at
#    http://localhost:11434 and thinks on your own RTX cards — you pay only
#    electricity. Nothing to set here if Ollama is on the same machine.
#
#    Remote hooks (fleet on OTHER machines using the GPU box): on the GPU
#    machine start Ollama listening on the LAN, then on each fleet machine set:
#    NEXUS_MODEL_URL=http://<gpu-machine-ip>:11434/v1/chat/completions
#    Keep it LAN-only — never expose an unauthenticated model server to the
#    internet.
#
# 2. PAID remote API (only if you set a key — billed by your provider):
# NEXUS_MODEL_API_KEY=            # your API key (never commit the real one)
# NEXUS_MODEL_URL=                # default: https://api.openai.com/v1/chat/completions
# NEXUS_MODEL_NAME=                # default: gpt-4o-mini
#
# ── Local model choice (NEXUS_THINK=local) ──────────────────────────────────
# NEXUS_MODEL_NAME also names the LOCAL model Ollama serves.
# This machine: RTX 5060 Ti 8GB + RTX 5060 8GB (16GB pooled). Recommended:
#   qwen3:14b       all-round reasoning (~9 GB — splits across BOTH cards)
#   gpt-oss:20b     agent work, long context (~12 GB — splits across both)
#   qwen3:8b / llama3.1:8b   fastest (~5 GB — fits on ONE card)
# Default local model: llama3.1:8b (fits any single card) — after
#   ollama pull qwen3:14b   you can set NEXUS_MODEL_NAME=qwen3:14b
#
# 3. OFF (default): deterministic fleet, $0.
