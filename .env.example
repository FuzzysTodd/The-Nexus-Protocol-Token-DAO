# Nexus Protocol — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Runtime ────────────────────────────────────────────────────────────────────
NEXUS_ENV=local          # local | remote

# ── Ports ─────────────────────────────────────────────────────────────────────
PORT=3000                # Main dashboard server
APPROVAL_SERVICE_PORT=8787
FINANCIAL_OPS_REST_PORT=8788
WITHDRAWS_PORT=8789
NEXUS_SIGNAL_BUS_PORT=8790

# ── Hosting (remote only) ──────────────────────────────────────────────────────
# NEXUS_HOST_URL=https://your-domain.com
# NEXUS_VERCEL_URL=https://nexus-protocol-dao.vercel.app

# ── Ethereum RPC ───────────────────────────────────────────────────────────────
# NEXUS_RPC_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY
# NEXUS_WS_RPC_URL=wss://mainnet.infura.io/ws/v3/YOUR_KEY
# RPC_URL_PRIMARY=https://mainnet.infura.io/v3/YOUR_KEY
# RPC_URL_FALLBACK=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Contract Addresses ────────────────────────────────────────────────────────
# NEXUS_BUILDER_FUND_ADDRESS=0x...
# NEXUS_GOVERNOR_ADDRESS=0x...
# NEXUS_TREASURY_ADDRESS=0x...
# NEXUS_TOKEN_ADDRESS=0x...
