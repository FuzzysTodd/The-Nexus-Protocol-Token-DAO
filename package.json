{
  "name": "the-nexus-protocol-token-dao",
  "version": "1.0.0",
  "description": "Nexus Protocol Token DAO — Dashboard & Governance Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:local": "bash scripts/start-local.sh",
    "start:remote": "bash scripts/start-remote.sh",
    "start:pm2": "pm2 start ecosystem.config.js",
    "start:docker": "docker-compose up -d",
    "stop:pm2": "pm2 stop all",
    "logs:pm2": "pm2 logs",
    "deploy:vercel": "vercel --prod",
    "dev": "NEXUS_ENV=local node server.js",
    "test": "echo \"No automated tests configured\" && exit 0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ethers": "^5.7.2",
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "keywords": [
    "dao",
    "ethereum",
    "web3",
    "nexus",
    "defi"
  ],
  "author": "FuzzysTodd",
  "license": "MIT"
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
